---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ContactClose from '../components/ContactClose.astro';
import { services } from '../data/services';
---
<Layout title="Cosmin Ghinoiu | Senior Client Delivery & Implementation Lead, Enterprise Software" description="Senior client delivery and implementation lead for enterprise software: implementations, migrations, service delivery and enterprise AI rollouts, mostly for pharma and life sciences. Open to permanent and contract roles and defined projects." current="/">
  <section class="home-intro">
    <div class="section-wrap">
      <div class="intro-grid">
        <div class="intro-main">
          <h1>Senior client delivery <br /><span>and <span class="select-box">implementation</span> lead.</span></h1>
          <div class="intro-copy">
            <p>I lead enterprise software delivery from requirements through launch and handover, and I stay with the client afterwards: onboarding and adoption, account and service reviews, escalations, integrations and the changes that come up once people are actually using the system. I coordinate clients, product, engineering and support teams, and I do a good part of the hands-on work myself, from data migration and configuration to training.</p>
            <p class="intro-credentials"><span class="sr-only">15 years of experience in enterprise software. Certifications: Project Management Professional (PMP), PRINCE2 Agile Foundation and ITIL 4 Foundation.</span><span class="cred-term" aria-hidden="true" data-lines="Project Management Professional (PMP)|PRINCE2 Agile Foundation|ITIL 4 Foundation|15 years of experience in enterprise software"><span class="term-prompt">›</span><span class="term-role">15 years in enterprise software · PMP · PRINCE2 Agile · ITIL 4</span><span class="term-caret"></span></span></p>
            <p class="intro-engagement">I’m open to permanent and contract roles, and to defined implementation projects.</p>
            <div class="button-row"><a class="button button-primary" href="/contact/">Discuss a role <Arrow /></a><a class="button button-secondary" href="/portfolio/">View portfolio <Arrow /></a></div>
          </div>
        </div>
        <div class="intro-side">
          <figure class="intro-portrait"><img src="/cosmin.webp" alt="Cosmin Ghinoiu" width="880" height="1178" fetchpriority="high" decoding="async" /></figure>
          <div class="intro-aside"><p>Most of my experience is with scientific-content platforms for global pharma and life-sciences organizations, including two enterprise AI rollouts delivered under content licensing constraints. I specialize in complex enterprise implementation programs and AI-enabled delivery programs.</p><a href="/about/">More about me <Arrow /></a></div>
        </div>
      </div>
      <div class="intro-proof intro-proof-grid">
        <p><strong>50+ specialized delivery projects</strong><span>Implementations, integrations, migrations, technical reviews and workflow redesigns, all as an employee between 2022 and July 2026.</span></p>
        <p><strong>5 strategic accounts, over $2M a year in licences</strong><span>Implementation and service manager for five enterprise SaaS accounts. Every account I managed renewed, and the contractual service levels were met throughout.</span></p>
        <p><strong>Two enterprise AI rollouts</strong><span>A 12-month pilot that went to a launch for 20,000 users, and a second client’s AI search and summarization for its power users.</span></p>
      </div>
    </div>
  </section>
  <section class="work-preview" aria-labelledby="work-title"><div class="section-wrap">
    <div class="section-heading"><h2 id="work-title">Selected delivery experience.</h2><a class="text-link" href="/portfolio/">View portfolio <Arrow /></a></div>
    <div class="project-list">
      <a class="project-row" href="/portfolio/#enterprise-rollout"><span>Enterprise AI delivery</span><h3>An AI pilot that became <br />a launch for 20,000 users.</h3><p>I led a 12-month pilot with nine client workstreams and six internal teams, and moved about 700,000 documents from the previous vendor in 40 days. When the AI answers fell short of what the client expected, I ran evaluation sessions with the client and worked with the engineers on the tuning. The pilot met its success criteria.</p><Arrow direction="up-right" /></a>
      <a class="project-row" href="/portfolio/#data-migration"><span>Hands-on implementation</span><h3>50,000+ documents migrated <br />into 25 libraries.</h3><p>I migrated the documents and their metadata into SaaS libraries myself, and I was responsible for the mapping, data quality, workflows and getting users ready for launch.</p><Arrow direction="up-right" /></a>
      <a class="project-row" href="/portfolio/#account-consolidation"><span>Client delivery</span><h3>Three accounts <br />consolidated into one.</h3><p>I led the consolidation into a single 10,000-user account and coordinated around 30 stakeholders until everyone signed off.</p><Arrow direction="up-right" /></a>
      <a class="project-row" href="/portfolio/#suppclaimcheck"><span>Independent AI project</span><h3>SuppClaimCheck: an AI service <br />I designed and run.</h3><p>Claude Code agents write the code under rules I set; I own the product, the evals, the security review, releases and operations. Verdict accuracy went from 47‑53% to 75‑81% across ten measured versions, inside a fixed budget enforced in code.</p><Arrow direction="up-right" /></a>
    </div>
    <p class="source-note">The first three are projects I delivered as an employee, with the clients anonymized. The user figures are the number of people each launch or account covered. SuppClaimCheck is my own project.</p>
  </div></section>
  <section class="engagement section-wrap" aria-labelledby="engagement-title"><h2 id="engagement-title">In your team, <br />or on a defined project.</h2><div><p>In a permanent or contract role, I can take responsibility for client delivery, implementation, service delivery or customer success alongside the teams already involved.</p><p>For a defined project, the scope might be a migration, a difficult rollout, an AI pilot, or preparing users and operations for launch and handover.</p><a class="text-link" href="/contact/">Discuss a project <Arrow /></a></div></section>
  <section class="situations section-wrap" aria-labelledby="situations-title">
    <div class="section-heading"><h2 id="situations-title">Where I can help.</h2><a class="text-link" href="/services/">Explore services <Arrow /></a></div>
    <div class="situation-list">
      {services.map((service) => <article class="situation"><div class="situation-main"><h3><a href={'/services/#' + service.id}>{service.title}<Arrow /></a></h3><p>{service.summary}</p></div><a class="evidence-link" href={service.href}><span>{service.proofTitle}</span><span class="evidence-action">Read the example <Arrow direction="up-right" /></span></a></article>)}
    </div>
  </section>
  <ContactClose />
  <script>
    // Credentials line under the intro: same type-and-delete rhythm as the wordmark's role line.
    const cred = document.querySelector<HTMLElement>('.cred-term');
    const credRole = cred?.querySelector<HTMLElement>('.term-role');
    const lines = (cred?.dataset.lines ?? '').split('|').filter(Boolean);
    if (cred && credRole && lines.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let text = credRole.textContent ?? '';
      let target = '';
      let next = 0;
      let mode: 'delete' | 'type' = 'delete';
      let timer = 0;
      let inView = true;
      let stalled = false;
      cred.classList.add('is-live');
      const schedule = (ms: number) => { timer = window.setTimeout(step, ms); };
      function step() {
        timer = 0;
        if (!inView || document.hidden) { stalled = true; return; }
        cred!.classList.add('is-typing');
        if (mode === 'delete') {
          if (text.length) { text = text.slice(0, -1); credRole!.textContent = text; schedule(18); return; }
          mode = 'type'; target = lines[next]; next = (next + 1) % lines.length; schedule(280); return;
        }
        if (text.length < target.length) { text = target.slice(0, text.length + 1); credRole!.textContent = text; schedule(40 + Math.random() * 40); return; }
        cred!.classList.remove('is-typing');
        mode = 'delete';
        schedule(3000);
      }
      const resume = () => { if (stalled && inView && !document.hidden && !timer) { stalled = false; schedule(350); } };
      new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; cred.classList.toggle('is-paused', !inView); resume(); }).observe(cred);
      document.addEventListener('visibilitychange', resume);
      schedule(3200);
    }
  </script>
</Layout>
