---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ContactClose from '../components/ContactClose.astro';
import { services } from '../data/services';
---
<Layout title="Cosmin Ghinoiu — Enterprise Implementation & Client Delivery" description="Senior implementation and client delivery lead for complex enterprise software. Enquiries welcome for contract roles and defined delivery projects." current="/">
  <section class="home-intro">
    <div class="section-wrap">
      <h1>Senior implementation <br /><span>and client delivery lead.</span></h1>
      <div class="intro-bottom">
        <div class="intro-copy">
          <p>I lead enterprise software delivery from requirements through launch and handover. I coordinate clients, product, engineering and operational teams, with hands-on work in migration, configuration and user enablement.</p>
          <p class="intro-engagement">I welcome enquiries about contract delivery roles and defined implementation projects.</p>
          <div class="button-row"><a class="button button-light" href="/contact/">Discuss a contract role <Arrow /></a><a class="text-link" href="/selected-work/">View selected work <Arrow /></a></div>
        </div>
        <div class="intro-aside"><p>My experience includes scientific-content platforms for global pharmaceutical and life-sciences organizations, including enterprise AI delivery.</p><a href="/about/">Meet Cosmin <Arrow /></a></div>
      </div>
      <p class="intro-proof"><strong>50+ specialized delivery projects</strong><span>Implementations, integrations, migrations, technical reviews and workflow redesigns, delivered during employment.</span></p>
    </div>
  </section>
  <section class="work-preview" aria-labelledby="work-title"><div class="section-wrap">
    <div class="section-heading"><h2 id="work-title">Selected delivery experience.</h2><a class="text-link" href="/selected-work/">View selected work <Arrow /></a></div>
    <div class="project-list">
      <a class="project-row" href="/selected-work/#enterprise-rollout"><span>Enterprise AI delivery</span><h3>From pilot to a launch <br />for 20,000 users.</h3><p>I led a 12-month implementation pilot across nine client workstreams and six internal teams. The user figure describes launch scope.</p><Arrow direction="up-right" /></a>
      <a class="project-row" href="/selected-work/#data-migration"><span>Hands-on implementation</span><h3>50,000+ documents. <br />25 configured libraries.</h3><p>I migrated documents and metadata into SaaS libraries, with responsibility for mapping, data quality, workflows and launch enablement.</p><Arrow direction="up-right" /></a>
      <a class="project-row" href="/selected-work/#account-consolidation"><span>Client delivery</span><h3>Three accounts. <br />One working setup.</h3><p>I led consolidation into a single 10,000-user account, coordinating around 30 stakeholders through full sign-off.</p><Arrow direction="up-right" /></a>
    </div>
    <p class="source-note">Examples of work I delivered during employment. Clients are anonymized; user figures describe launch or account scope, not measured active use.</p>
  </div></section>
  <section class="engagement section-wrap" aria-labelledby="engagement-title"><h2 id="engagement-title">Part of your team. <br />Or leading a defined project.</h2><div><p>In an embedded contract role, I can take responsibility for implementation and client delivery alongside the teams already involved.</p><p>For a defined project, the scope might be a migration, a difficult rollout, or preparing users and operations for launch and handover.</p><a class="text-link" href="/contact/">Discuss a project <Arrow /></a></div></section>
  <section class="situations section-wrap" aria-labelledby="situations-title">
    <div class="section-heading"><h2 id="situations-title">Where I can help.</h2><a class="text-link" href="/services/">Explore services <Arrow /></a></div>
    <div class="situation-list">
      {services.map((service) => <article class="situation"><div class="situation-main"><h3><a href={'/services/#' + service.id}>{service.title}<Arrow /></a></h3><p>{service.summary}</p></div><a class="evidence-link" href={service.href}><span>{service.proofTitle}</span><span class="evidence-action">Read the example <Arrow direction="up-right" /></span></a></article>)}
    </div>
  </section>
  <ContactClose />
</Layout>
