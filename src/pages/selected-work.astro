---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ContactClose from '../components/ContactClose.astro';
import * as rollout from '../content/work/enterprise-rollout.md';
import * as consolidation from '../content/work/account-consolidation.md';
import * as handover from '../content/work/operational-handover.md';
import * as migration from '../content/work/data-migration.md';
const projects = [ { id: 'enterprise-rollout', ...rollout }, { id: 'data-migration', ...migration }, { id: 'account-consolidation', ...consolidation }, { id: 'operational-handover', ...handover } ];
---
<Layout title="Selected Implementation & Client Delivery Work — Cosmin Ghinoiu" description="Enterprise AI delivery, hands-on SaaS migration, account consolidation and operational handover. Anonymized examples delivered during employment." current="/selected-work/">
  <section class="page-intro section-wrap"><h1>Work carried <br />through to use.</h1><p class="lead">Four examples of implementation and client delivery, from hands-on migration to enterprise rollout. I delivered these projects during employment; client details are anonymized.</p><nav class="page-index" aria-label="Project examples">{projects.map(project => <a href={'#' + project.id}>{project.frontmatter.title}<Arrow /></a>)}</nav></section>
  <div class="section-wrap case-studies">{projects.map(({id, frontmatter, Content}) => <article class="case-study" id={id} aria-labelledby={id + '-title'}><header class="case-header"><h2 id={id + '-title'}>{frontmatter.title}</h2><dl><div><dt>Client context</dt><dd>{frontmatter.client}</dd></div><div><dt>My role</dt><dd>{frontmatter.role}</dd></div><div><dt>Scope</dt><dd>{frontmatter.scope}</dd></div></dl><p class="case-attribution">Delivered during employment.</p></header><div class="case-body"><p class="case-responsibility" id={id === 'enterprise-rollout' ? 'my-responsibility' : undefined}>{frontmatter.responsibility}</p><div class="case-result" id={id === 'enterprise-rollout' ? 'what-changed' : undefined}><span>Result</span><p>{frontmatter.result}</p>{frontmatter.resultNote && <small>{frontmatter.resultNote}</small>}</div><div class="prose" id={id === 'enterprise-rollout' ? 'the-situation' : undefined}><Content /></div><a class="text-link" href="/contact/">Discuss a role or project <Arrow /></a></div></article>)}</div>
  <ContactClose />
</Layout>
