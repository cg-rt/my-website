---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ContactClose from '../components/ContactClose.astro';
import * as rollout from '../content/work/enterprise-rollout.md';
import * as suppclaimcheck from '../content/work/suppclaimcheck.md';
import * as migration from '../content/work/data-migration.md';
import * as restructuring from '../content/work/account-restructuring.md';
import * as recovery from '../content/work/account-recovery.md';
import * as consolidation from '../content/work/account-consolidation.md';
import * as handover from '../content/work/operational-handover.md';
const projects = [ { id: 'enterprise-rollout', ...rollout }, { id: 'suppclaimcheck', ...suppclaimcheck }, { id: 'data-migration', ...migration }, { id: 'account-restructuring', ...restructuring }, { id: 'account-recovery', ...recovery }, { id: 'account-consolidation', ...consolidation }, { id: 'operational-handover', ...handover } ];
---
<Layout title="Portfolio: Enterprise AI, Migration, Service Delivery | Cosmin Ghinoiu" description="Anonymized examples from employment plus one independent AI project: a 20,000-user AI launch, a 700,000-document migration, a live account restructuring, a strained account brought back, and SuppClaimCheck." current="/portfolio/">
  <section class="page-intro section-wrap"><h1>Projects <br />I’ve delivered.</h1><p class="lead">Seven examples of implementation, client delivery, customer success and AI work. Six are projects I delivered during employment, with client details anonymized; one is my own.</p><nav class="page-index" aria-label="Project examples">{projects.map(project => <a href={'#' + project.id}>{project.frontmatter.title}<Arrow /></a>)}</nav></section>
  <div class="section-wrap case-studies">{projects.map(({id, frontmatter, Content}) => <article class="case-study" id={id} aria-labelledby={id + '-title'}><header class="case-header"><h2 id={id + '-title'}>{frontmatter.title}</h2><dl><div><dt>Client context</dt><dd>{frontmatter.client}</dd></div><div><dt>My role</dt><dd>{frontmatter.role}</dd></div><div><dt>Scope</dt><dd>{frontmatter.scope}</dd></div></dl><p class="case-attribution">{frontmatter.attribution ?? 'Delivered during employment.'}</p></header><div class="case-body"><p class="case-responsibility" id={id === 'enterprise-rollout' ? 'my-responsibility' : undefined}>{frontmatter.responsibility}</p><div class="case-result" id={id === 'enterprise-rollout' ? 'what-changed' : undefined}><span>Result</span><p>{frontmatter.result}</p>{frontmatter.resultNote && <small>{frontmatter.resultNote}</small>}</div><div class="prose" id={id === 'enterprise-rollout' ? 'the-situation' : undefined}><Content /></div><a class="text-link" href="/contact/">Discuss a role or project <Arrow /></a></div></article>)}</div>
  <ContactClose />
</Layout>
