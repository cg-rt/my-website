---
interface Props { direction?: 'right' | 'up-right'; }
const { direction = 'right' } = Astro.props;
---
<svg class:list={['arrow', { 'arrow-diagonal': direction === 'up-right' }]} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
